{
  "ConnectionStrings": {
    "ECommerceDatabase": "Data Source=aygaz-ecommerce-v2.db"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3:4b-instruct",
    "GpuLayers": 0,
    "ContextSize": 4096,
    "MaxOutputTokens": 512
  },
  "Agent": {
    "MaxToolIterations": 5,
    "MaxToolCallsPerIteration": 3,
    "MaxNameSearchResults": 5,
    "MaxOrderSearchResults": 5,
    "MaxConversationTurns": 4
  },
  "DomainGuardrail": {
    "Domain": "E-Commerce",
    "AllowedOrganizations": [
      "Aygaz"
    ],
    "AllowedCapabilities": [
      "CustomerLookup",
      "CustomerSearch",
      "OrderLookup",
      "CustomerOrders",
      "OrderStatus"
    ],
    "MaxInputCharacters": 1000,
    "ClassifierMaxOutputTokens": 32
  }
}
