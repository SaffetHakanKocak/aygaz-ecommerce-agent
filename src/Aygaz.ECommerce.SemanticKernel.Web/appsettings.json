{
  "DataAccess": {
    "Provider": "MongoDb",
    "MongoDb": {
      "ConnectionString": "mongodb://localhost:27017",
      "DatabaseName": "aygaz-ecommerce",
      "SeedDummyData": false
    },
    "Sqlite": {
      "ConnectionString": "Data Source=aygaz-ecommerce.db"
    },
    "SqlServer": {
      "ConnectionString": ""
    }
  },
  "ConnectionStrings": {
    "ECommerceDatabase": "Data Source=aygaz-ecommerce-sk-web.db"
  },
  "SemanticKernel": {
    "Provider": "Groq",
    "ModelId": "openai/gpt-oss-20b",
    "Endpoint": "https://api.groq.com/openai/v1"
  },
  "Rag": {
    "StoreProvider": "MongoDb",
    "EmbeddingProvider": "Lexical",
    "DocumentsPath": "data/demo-documents",
    "MaxRetrievalResults": 3,
    "MaxQueryLength": 500,
    "MinimumSimilarityScore": 0.15,
    "AutoIngestOnStartup": true
  },
  "ChatApi": {
    "MaxMessageLength": 2000
  }
}
