{
  "ConnectionStrings": {
    "ECommerceDatabase": "Data Source=aygaz-ecommerce-v4.db"
  },
  "Commerce": {
    "CurrencyCode": "TRY",
    "AnalyticsReferenceDate": "2026-03-06",
    "MaximumAnalysisRangeDays": 366,
    "MaximumTopProducts": 10
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3:1.7b",
    "EmbeddingModel": "nomic-embed-text",
    "KeepAlive": "15m",
    "EmbeddingKeepAlive": "1m",
    "ContextSize": 4096,
    "MaxOutputTokens": 512
  },
  "Rag": {
    "StoreProvider": "MongoDb",
    "EmbeddingProvider": "Lexical",
    "DocumentsPath": "data/demo-documents",
    "MaxRetrievalResults": 3,
    "MaxQueryLength": 500,
    "MinimumSimilarityScore": 0.15,
    "AutoIngestOnStartup": true
  },
  "Agent": {
    "MaxToolIterations": 5,
    "MaxToolCallsPerIteration": 3,
    "MaxNameSearchResults": 5,
    "MaxOrderSearchResults": 5,
    "MaxProductSearchResults": 5,
    "MaxInventoryLocationResults": 5,
    "MaxConversationTurns": 4
  },
  "DomainGuardrail": {
    "Domain": "E-Commerce",
    "Model": "qwen3:1.7b",
    "AllowedOrganizations": [
      "Aygaz"
    ],
    "AllowedCapabilities": [
      "CustomerLookup",
      "CustomerSearch",
      "OrderLookup",
      "CustomerOrders",
      "OrderStatus",
      "ProductLookup",
      "ProductSearch",
      "InventoryLookup",
      "StockAvailability",
      "SalesSummary",
      "TopSellingProducts",
      "CustomerPurchaseSummary",
      "DocumentSearch",
      "ReturnPolicyLookup",
      "DeliveryPolicyLookup",
      "CampaignPolicyLookup",
      "CustomerSupportProcedures"
    ],
    "MaxInputCharacters": 1000,
    "ClassifierMaxOutputTokens": 32
  },
  "ChatApi": {
    "MaxMessageLength": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
